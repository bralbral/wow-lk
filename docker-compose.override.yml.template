# Copied into server/docker-compose.override.yml by scripts/bootstrap.sh.
# It deliberately overlays the compose file supplied by the Playerbot core.
services:
  ac-worldserver:
    image: ${WOW_IMAGE_PREFIX:-acore/ac-wotlk}-worldserver:${WOW_IMAGE_TAG:-master}
    ports: !override
      - "${WOW_BIND_ADDRESS:-127.0.0.1}:${DOCKER_WORLD_EXTERNAL_PORT:-8085}:8085"
      - "${WOW_BIND_ADDRESS:-127.0.0.1}:${DOCKER_SOAP_EXTERNAL_PORT:-7878}:7878"
      - "${DOCKER_GAME_STATE_API_BIND_ADDRESS:-127.0.0.1}:${DOCKER_GAME_STATE_API_EXTERNAL_PORT:-8080}:8080"
    env_file:
      - conf/wow.env
    volumes:
      - ./modules:/azerothcore/modules:ro
    depends_on:
      wow-module-config-init:
        condition: service_completed_successfully
      wow-extra-module-schema-init:
        condition: service_completed_successfully
      wow-realm-init:
        condition: service_completed_successfully

  ac-authserver:
    image: ${WOW_IMAGE_PREFIX:-acore/ac-wotlk}-authserver:${WOW_IMAGE_TAG:-master}
    ports: !override
      - "${WOW_BIND_ADDRESS:-127.0.0.1}:${DOCKER_AUTH_EXTERNAL_PORT:-3724}:3724"

  ac-database:
    ports: !override
      - "${WOW_BIND_ADDRESS:-127.0.0.1}:${DOCKER_DB_EXTERNAL_PORT:-3306}:3306"
    volumes: !override
      - "${WOW_DB_DATA_DIR:-../data/mysql}:/var/lib/mysql"

  ac-db-import:
    image: ${WOW_IMAGE_PREFIX:-acore/ac-wotlk}-db-import:${WOW_IMAGE_TAG:-master}

  ac-client-data-init:
    image: ${WOW_IMAGE_PREFIX:-acore/ac-wotlk}-client-data:${WOW_IMAGE_TAG:-master}
    # Client data is written once into a named Docker volume. Run the writer as
    # root so both a fresh volume and one created by an earlier image can be
    # initialized; worldserver only mounts this volume read-only.
    user: "0:0"
    # The upstream image currently hardcodes v19, while this core requires
    # v20 mmaps. Keep the data format pinned across fresh volumes and restarts.
    entrypoint: []
    command:
      - /bin/bash
      - -ec
      - |
        data=/azerothcore/env/dist/data
        version_file="$$data/data-version"
        if [ -f "$$version_file" ] && grep -qx 'INSTALLED_VERSION=v20' "$$version_file"; then
          echo 'Client data v20 already installed.'
          exit 0
        fi
        rm -rf "$$data"/*
        curl -L --fail --retry 3 --output "$$data/data.zip" https://github.com/wowgaming/client-data/releases/download/v20.0/data.zip
        unzip -q "$$data/data.zip" -d "$$data"
        rm "$$data/data.zip"
        printf 'INSTALLED_VERSION=v20\\n' > "$$version_file"

  # Creates persistent module configs from the image templates once. This runs
  # before worldserver and never overwrites an existing local configuration.
  wow-module-config-init:
    image: ${WOW_IMAGE_PREFIX:-acore/ac-wotlk}-worldserver:${WOW_IMAGE_TAG:-master}
    entrypoint: []
    command:
      - /bin/sh
      - -ec
      - |
        for name in playerbots mod_ahbot transmog dungeonrespawn mod_dungeon_clear IpTracker mod_autofish gamestate_api mod_autosort mod_autolearn_skills mod_aoe_loot; do
          target="/azerothcore/env/dist/etc/modules/$${name}.conf"
          dist="/azerothcore/env/ref/etc/modules/$${name}.conf.dist"
          if [ ! -f "$$target" ] && [ -f "$$dist" ]; then cp "$$dist" "$$target"; fi
        done
    volumes:
      - ${DOCKER_VOL_ETC:-./env/dist/etc}:/azerothcore/env/dist/etc
    restart: "no"

  # Realm fields live in acore_auth, not in worldserver.conf. This small,
  # idempotent job makes them controllable through .env too.
  wow-realm-init:
    image: mysql:8.4
    networks:
      - ac-network
    restart: "no"
    environment:
      MYSQL_PWD: "${DOCKER_DB_ROOT_PASSWORD}"
      WOW_REALM_NAME: "${WOW_REALM_NAME}"
      WOW_REALM_ADDRESS: "${WOW_REALM_ADDRESS}"
    command:
      - /bin/sh
      - -ec
      - >-
        until mysql -h ac-database -u root -e 'SELECT 1' >/dev/null 2>&1; do sleep 2; done;
        until mysql -h ac-database -u root acore_auth -e 'SELECT 1 FROM realmlist LIMIT 1' >/dev/null 2>&1; do sleep 2; done;
        mysql -h ac-database -u root acore_auth -e
        "UPDATE realmlist SET name='$$WOW_REALM_NAME', address='$$WOW_REALM_ADDRESS' WHERE id=1;"
    depends_on:
      ac-db-import:
        condition: service_completed_successfully

  # Applies idempotent base schemas that third-party modules keep outside
  # AzerothCore's normal data/sql update tree. It runs after db-import and
  # before worldserver, so a fresh bootstrap needs no manual SQL import.
  wow-extra-module-schema-init:
    image: mysql:8.4
    networks:
      - ac-network
    restart: "no"
    environment:
      MYSQL_PWD: "${DOCKER_DB_ROOT_PASSWORD}"
    command:
      - /bin/sh
      - -ec
      - >-
        until mysql -h ac-database -u root acore_characters -e 'SELECT 1' >/dev/null 2>&1; do sleep 2; done;
        mysql -h ac-database -u root acore_characters < /sql/dungeonrespawn.sql;
        mysql -h ac-database -u root acore_auth < /sql/account-ip.sql;
    volumes:
      - ./module-schema/dungeonrespawn.sql:/sql/dungeonrespawn.sql:ro
      - ./module-schema/account-ip.sql:/sql/account-ip.sql:ro
    depends_on:
      ac-db-import:
        condition: service_completed_successfully
