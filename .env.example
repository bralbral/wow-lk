# Copy to .env, then change the database password before the first start.
# This file configures Docker Compose and the AzerothCore settings below.

# Network: leave 127.0.0.1 for a machine used only locally.  For a LAN server,
# set the host LAN address here and use the same address in WOW_REALM_ADDRESS.
WOW_BIND_ADDRESS=127.0.0.1
WOW_REALM_NAME="My WotLK Realm"
WOW_REALM_ADDRESS=127.0.0.1

# Docker / database. Do not change DOCKER_DB_ROOT_PASSWORD after the first
# successful start without updating the existing database volume as well.
DOCKER_DB_ROOT_PASSWORD=change-this-long-password
DOCKER_DB_EXTERNAL_PORT=3306
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_GAME_STATE_API_BIND_ADDRESS=127.0.0.1
DOCKER_GAME_STATE_API_EXTERNAL_PORT=8080
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
# Path is evaluated from server/, where Docker Compose runs. The default puts
# MySQL files in <this-repository>/data/mysql on the host, not in a volume.
WOW_DB_DATA_DIR=../data/mysql

# Built images. Leave these unset to use the default AzerothCore image names
# during local source builds. GitHub Actions publishes concrete AMD64 images to Docker Hub;
# set both values to consume a published set without rebuilding.
# WOW_IMAGE_PREFIX=bral1488/wowlk
# WOW_IMAGE_TAG=<full-git-sha-or-build-date>

# Core gameplay.
WOW_GAME_TYPE=0
WOW_MAX_PLAYERS=20
WOW_MAP_UPDATE_THREADS=2
WOW_RATE_XP_KILL=1
WOW_RATE_XP_QUEST=1
WOW_RATE_MONEY=1
WOW_DATABASE_UPDATES=7

# Playerbots. Start with a modest number; increase only after observing CPU/RAM.
WOW_PLAYERBOTS_ENABLED=1
WOW_RANDOM_BOTS_AUTOLOGIN=1
WOW_RANDOM_BOTS_MIN=30
WOW_RANDOM_BOTS_MAX=50
WOW_BOTS_ONLY_WITH_PLAYERS=0

# Auction bot. WOW_AHBOT_GUIDS must be a regular character GUID, not a
# Playerbot GUID. Leave it 0 until the character is created (see the guide).
WOW_AHBOT_GUIDS=0
WOW_AHBOT_SELLER=true
WOW_AHBOT_BUYER=true
WOW_AHBOT_ITEMS_PER_CYCLE=300
WOW_AHBOT_BUY_CANDIDATES=5
WOW_AHBOT_BUY_PRICE_MODIFIER=0.85
WOW_AHBOT_ALLIANCE_ITEMS=1500
WOW_AHBOT_HORDE_ITEMS=1500
WOW_AHBOT_NEUTRAL_ITEMS=500

# Transmogrification.
WOW_TRANSMOG_ENABLED=1
WOW_TRANSMOG_COLLECTION=1
WOW_TRANSMOG_VENDOR_INTERFACE=1
WOW_TRANSMOG_PORTABLE=1
WOW_TRANSMOG_SCALED_COST=0.0
WOW_TRANSMOG_COPPER_COST=0
WOW_TRANSMOG_MIXED_WEAPONS=1

# Dungeon Respawn.
WOW_DUNGEON_RESPAWN_ENABLED=1
WOW_DUNGEON_RESPAWN_HEALTH_PCT=50.0

# IP Tracker. Set cleanup days to 0 to keep all collected IP history.
WOW_IP_TRACKER_ENABLED=1
WOW_IP_TRACKER_CLEANUP_DAYS=0

# Autofish.
WOW_AUTOFISH_ENABLED=1
WOW_AUTOFISH_TICK_MS=200
WOW_AUTOFISH_SCAN_RANGE=30.0
WOW_AUTOFISH_BOBBER_ENTRIES=35591
WOW_AUTOFISH_SERVER_AUTO_LOOT=1
WOW_AUTOFISH_AUTO_RECAST=1
WOW_AUTOFISH_RECAST_DELAY_MS=500
WOW_AUTOFISH_RECAST_SPELL=18248
WOW_AUTOFISH_AUTO_LOOT_DELAY_MS=120
WOW_AUTOFISH_REQUIRED_ITEM_ID=0
WOW_AUTOFISH_REQUIRED_EQUIP_ID=0

# Game State API. It is disabled by default because it exposes realm data.
WOW_GAME_STATE_API_ENABLED=0
WOW_GAME_STATE_API_HOST=0.0.0.0
WOW_GAME_STATE_API_PORT=8080
WOW_GAME_STATE_API_ALLOWED_ORIGIN=*

# Autosort.
WOW_AUTOSORT_ENABLED=1
WOW_AUTOSORT_MERGE_STACKS=1
WOW_AUTOSORT_SORT_BAGS=1
WOW_AUTOSORT_ON_LOGIN=0
WOW_AUTOSORT_COOLDOWN=5
WOW_AUTOSORT_PINNED_ITEMS=6948
WOW_AUTOSORT_PERIODIC_ENABLED=0
WOW_AUTOSORT_PERIODIC_INTERVAL=60
WOW_AUTOSORT_PERIODIC_SKIP_IF_LOOTING=1
WOW_AUTOSORT_PERIODIC_SKIP_IN_COMBAT=1
WOW_AUTOSORT_PERIODIC_SORT_BANK=0
WOW_AUTOSORT_PERIODIC_MESSAGE=

# Autolearn Skills.
WOW_AUTOLEARN_SKILLS_ENABLED=1
WOW_AUTOLEARN_WEAPON_SKILLS=1
WOW_AUTOLEARN_MAX_WEAPON_SKILLS=1
WOW_AUTOLEARN_RIDING=1
WOW_AUTOLEARN_RIDING_APPRENTICE=1
WOW_AUTOLEARN_GRANT_APPRENTICE_MOUNT=1
WOW_AUTOLEARN_RIDING_JOURNEYMAN=0
WOW_AUTOLEARN_GRANT_JOURNEYMAN_MOUNT=0
WOW_AUTOLEARN_RIDING_EXPERT=0
WOW_AUTOLEARN_GRANT_EXPERT_MOUNT=0
WOW_AUTOLEARN_RIDING_ARTISAN=0
WOW_AUTOLEARN_GRANT_ARTISAN_MOUNT=0
WOW_AUTOLEARN_COLD_WEATHER=0

# AOE Loot.
WOW_AOE_LOOT_ENABLED=1
WOW_AOE_LOOT_MESSAGE=0
WOW_AOE_LOOT_RANGE=55.0
WOW_AOE_LOOT_IN_GROUP=1
