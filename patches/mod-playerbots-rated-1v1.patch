+bool BGJoinAction::ensureOneVsOneArenaTeam(uint32 matchmakerRating)
+{
+    constexpr ArenaType ARENA_TYPE_1V1 = static_cast<ArenaType>(1);
+
+    if (ArenaTeam* team = sArenaTeamMgr->GetArenaTeamByCaptain(bot->GetGUID(), ARENA_TYPE_1V1))
+    {
+        // Match the queued player's MMR so the core starts the rated game immediately.
+        team->SetRatingForAll(matchmakerRating);
+        team->SaveToDB();
+        return true;
+    }
+
+    if (bot->GetLevel() < sConfigMgr->GetOption<uint32>("Arena1v1.MinLevel", 80))
+        return false;
+
+    ArenaTeam* team = new ArenaTeam();
+    std::string const name = bot->GetName() + " 1v1";
+    if (!team->Create(bot->GetGUID(), ARENA_TYPE_1V1, name, 0, 0, 0, 0, 0))
+    {
+        delete team;
+        return false;
+    }
+
+    team->SetCaptain(bot->GetGUID());
+    team->SetRatingForAll(matchmakerRating);
+    team->SaveToDB();
+    sArenaTeamMgr->AddArenaTeam(team);
+    return true;
+}
